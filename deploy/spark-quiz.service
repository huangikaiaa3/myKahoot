[Unit]
Description=Spark Quiz FastAPI server
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/spark-quiz
Environment="PATH=/opt/spark-quiz/.venv/bin"
Environment="QUESTIONS_ADMIN_PASSWORD=replace-with-a-long-unique-password"
ExecStart=/opt/spark-quiz/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
